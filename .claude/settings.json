{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npx playwright *)",
      "Bash(npx lhci *)",
      "Bash(npx --no-install *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx impeccable *)",
      "Bash(node scripts/factory/*)",
      "Bash(bash scripts/factory/*)",
      "Bash(pip install fonttools brotli)",
      "Bash(pyftsubset *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git branch*)",
      "Bash(curl -s *)",
      "Bash(curl -sf *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cat *)",
      "Bash(du *)",
      "Bash(find *)",
      "WebFetch(domain:llmstxt.org)",
      "WebFetch(domain:schema.org)",
      "WebFetch(domain:developers.google.com)",
      "WebFetch(domain:nextjs.org)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Read(./.env*)",
      "Edit(./.env*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/scripts/factory/hooks/post-edit.sh\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/scripts/factory/hooks/stop-gate.sh\"" }
        ]
      }
    ]
  }
}
